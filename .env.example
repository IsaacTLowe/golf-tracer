# Copy to .env (or run `pnpm supabase:env`, which fills the Supabase values from `supabase status`).

# Supabase as seen from the browser and from your machine.
SUPABASE_URL=http://127.0.0.1:54321
# Public (anon / publishable) key: web only.
SUPABASE_ANON_KEY=
# Service role (secret) key: API and worker only. Never ship it to clients.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
# Optional: legacy HS256 JWT secret. Leave empty when the project uses asymmetric signing keys (JWKS).
SUPABASE_JWT_SECRET=

# Postgres, direct or session-mode connection (LISTEN/NOTIFY and SKIP LOCKED need it).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# The API as seen from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Write tracing debug videos to media/{user}/{clip}/debug.mp4.
TRACE_DEBUG=0

# Optional overrides for the containers (defaults reach the CLI's Supabase via the host).
# SUPABASE_INTERNAL_URL=http://host.docker.internal:54321
# DATABASE_INTERNAL_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres
# WORKER_REPLICAS=1
# WATERMARK=0
# APP_NAME=Golf Tracer

# OAuth providers for local Supabase (also set enabled = true in supabase/config.toml).
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
