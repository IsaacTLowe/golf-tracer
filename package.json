{
  "name": "golf-tracer",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:web": "pnpm --filter @golf-tracer/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "gen:api-client": "pnpm --filter @golf-tracer/api-client generate",
    "supabase": "supabase",
    "supabase:keys": "node scripts/ensure-signing-key.mjs",
    "supabase:start": "node scripts/ensure-signing-key.mjs && supabase start",
    "supabase:env": "node scripts/supabase-env.mjs"
  },
  "devDependencies": {
    "supabase": "2.121.0",
    "typescript": "6.0.3"
  }
}
